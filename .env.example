# Security & Debug Settings
SECRET_KEY=sua-chave-secreta-bem-longa-e-segura-aqui
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0

# Database Configuration
# MySQL:    mysql://USER:PASSWORD@HOST:PORT/DBNAME
# SQLite:   sqlite:///db.sqlite3
DATABASE_URL=mysql://examina_user:sua_senha_aqui@db:3306/examina_db

# Staging / Homologação (leave empty to disable)
STAGING_DATABASE_URL=

# Connection pool: seconds to keep connections alive (0 = close after each request)
DB_CONN_MAX_AGE=0

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL — defaults to DEBUG when DEBUG=True, WARNING otherwise)
LOG_LEVEL=DEBUG

# HTTPS & CSRF Trusted Origins (production only — ignored when DEBUG=True)
# List the full origins (scheme + host) of your production server.
# Required when Django sits behind a reverse proxy (Nginx, Traefik, Caddy).
# Example: https://examina.suainstituicao.edu.br,https://www.examina.suainstituicao.edu.br
CSRF_TRUSTED_ORIGINS=

# CSV/XLSX import: maximum file size accepted (in MB). Default: 5 MB.
CSV_UPLOAD_MAX_SIZE_MB=5
