# Security & Debug Settings
SECRET_KEY=sua-chave-secreta-bem-longa-e-segura-aqui
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
# MySQL:    mysql://USER:PASSWORD@HOST:PORT/DBNAME
# SQLite:   sqlite:///db.sqlite3
DATABASE_URL=mysql://examina_user:sua_senha_aqui@db:3306/examina_db

# Credenciais do container MySQL (docker-compose). Devem bater com o DATABASE_URL acima.
# Obrigatórias no docker-compose.prod.yml; no de desenvolvimento há valores padrão.
MYSQL_DATABASE=examina_db
MYSQL_USER=examina_user
MYSQL_PASSWORD=sua_senha_aqui
MYSQL_ROOT_PASSWORD=root_password_aqui

# Staging / Homologação (leave empty to disable)
STAGING_DATABASE_URL=

# Connection pool: seconds to keep connections alive (0 = close after each request)
DB_CONN_MAX_AGE=0

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL — defaults to DEBUG when DEBUG=True, WARNING otherwise)
LOG_LEVEL=DEBUG

# HTTPS & CSRF Trusted Origins (production only — ignored when DEBUG=True)
# List the full origins (scheme + host) of your production server.
# Required when Django sits behind a reverse proxy (Nginx, Traefik, Caddy).
# Example: https://examina.suainstituicao.edu.br,https://www.examina.suainstituicao.edu.br
CSRF_TRUSTED_ORIGINS=

# Servidor próprio (VPS) com HTTPS automático pelo Caddy do docker-compose.prod.yml:
# COMPOSE_PROFILES=caddy
# DOMINIO=examina.seudominio.com.br
# (scripts/criar_env_producao.sh gera um .env de produção completo — ver docs/deploy.md)

# Produção atrás de proxy HTTPS (ignorado com DEBUG=True).
# BEHIND_PROXY=True confia no cabeçalho X-Forwarded-Proto do proxy — só habilite se o
# proxy SEMPRE o define; sem isso, SECURE_SSL_REDIRECT entra em loop de redirecionamento.
BEHIND_PROXY=False
# Deixe True, a menos que o proxy já faça o redirecionamento HTTP -> HTTPS.
SECURE_SSL_REDIRECT=True

# Estáticos/mídia (opcional; padrões: <projeto>/staticfiles e <projeto>/media)
# STATIC_ROOT=/app/staticfiles
# MEDIA_ROOT=/app/media

# Gunicorn (produção) — ver gunicorn.conf.py
GUNICORN_WORKERS=3
# Segundos; o proxy HTTP precisa de timeout >= este valor (ZIP de folhas/correção em lote).
GUNICORN_TIMEOUT=120
# docker-compose.prod.yml: interface/porta publicadas no host
# WEB_BIND=127.0.0.1
# WEB_PORT=8000

# Limite de tentativas de login: depois de LOGIN_MAX_TENTATIVAS senhas erradas do mesmo
# usuário em LOGIN_BLOQUEIO_MINUTOS, o login dele fica bloqueado até a janela passar.
# Para desbloquear antes: admin > "Tentativas de login malsucedidas" > apagar as do usuário.
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# Sessão: no login, "Manter conectado neste computador" marcado = 2 semanas; desmarcado = termina
# ao fechar o navegador e depois deste tempo sem uso (padrão 120). Não deixe a linha vazia.
# SESSAO_INATIVIDADE_MINUTOS=120

# E-mail do administrador: aviso de falha no backup e erros internos (500).
# Sem EMAIL_HOST, nada é enviado (os e-mails só aparecem no log). Teste com:
#   python manage.py sendtestemail --admins
ADMINS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# True para a porta 465 (SSL); na 587 o padrão é STARTTLS.
EMAIL_USE_SSL=False
EMAIL_REMETENTE=

# CSV/XLSX import: maximum file size accepted (in MB). Default: 5 MB.
CSV_UPLOAD_MAX_SIZE_MB=5
# Importação com imagens (.zip = planilha + pasta de imagens): tamanho do ZIP e de cada imagem (MB).
IMPORT_ZIP_MAX_SIZE_MB=50
IMPORT_IMAGEM_MAX_SIZE_MB=5
