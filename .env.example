# Security & Debug Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# Database Configuration (Examples: postgres://user:password@localhost:5432/dbname or sqlite:///db.sqlite3)
DATABASE_URL=sqlite:///db.sqlite3

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL — defaults to DEBUG when DEBUG=True, WARNING otherwise)
LOG_LEVEL=DEBUG
