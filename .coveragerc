[run]
source =
    Examina
    banco_questoes
    provas
    academico
    desempenho
omit =
    */migrations/*
    */tests/*
    **/tests.py
    manage.py
    */wsgi.py
    */asgi.py

[report]
show_missing = True
# Piso conservador anti-regressão (cobertura medida ~86%, com desempenho). Aumentar gradualmente; meta: 90%.
fail_under = 80
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.
    raise NotImplementedError
